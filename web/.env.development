# Loaded by `next dev` only (not build/start). Non-secret local defaults.
#
# The BFF proxies /bff/* to this ragctl API. Local `mise run api` listens on
# :8091 (repo-root .env RAGCTL_ADDR=:8091 — kept off :8080 so a wgo watcher can
# hold :8080). The code fallback in lib/config.ts is :8080 (the container port
# used by docker-compose); this override makes `next dev` hit the host API.
RAGCTL_API_URL=http://localhost:8091
