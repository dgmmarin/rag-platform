# Copy to .env for local development (docker compose reads .env automatically).
#
# All host ports are overridable so you can dodge collisions with other local
# stacks. If a `docker compose up` fails with "port is already allocated",
# change the corresponding *_PORT below.

# --- Postgres (control plane + tenant DBs) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=control_plane
POSTGRES_PORT=5432

# --- MinIO (object storage) ---
# NOTE: :9000 commonly collides with other local MinIO containers. If so, set
# MINIO_PORT to a free port (e.g. 19000) and MINIO_CONSOLE_PORT (e.g. 19001).
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Object storage the app (ragctl serve) uses for raw document bytes (STORY-06.3,
# SPEC-04 §5). In docker-compose the `app` service reaches MinIO at
# http://minio:9000; a HOST process (mprocs `ragctl serve`) reaches it at
# localhost:${MINIO_PORT}. An empty endpoint leaves POST /v1/documents on its
# not_found seam. OBJECT_STORE_SECRET_KEY is confidential and never logged.
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=minio
OBJECT_STORE_SECRET_KEY=minio12345
OBJECT_STORE_BUCKET=rag-uploads
OBJECT_STORE_REGION=us-east-1

# --- Query embedding (STORY-08.2, FR-RET-08, SPEC-06 §2) ---
# POST /v1/retrieve embeds the incoming query with the tenant's configured
# embedding provider (the same provider used at ingest). EMBEDDING_API_KEY is the
# platform key that authenticates to it — confidential, never logged (C-4). An
# empty key leaves /v1/retrieve on a clean "could not embed" error. EMBEDDING_BASE_URL
# overrides the provider endpoint for a self-hosted/proxy deployment (e.g. TEI).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- LLM answering (STORY-08.4, SPEC-06 §5-6, NFR-MNT-02/REL-04) ---
# The answering layer generates the grounded answer with the tenant's configured
# LLM provider (settings.llm.{provider,model}). Platform keys per provider, gated
# by settings.providers_allowed. All are confidential and never logged (C-4).
# Anthropic uses the official SDK; OpenAI and OpenAI-compatible (vLLM/Ollama) are
# raw HTTP against /v1/chat/completions and share OPENAI_API_KEY, with
# OPENAI_BASE_URL selecting a compatible server (e.g. http://localhost:11434/v1
# for Ollama, or a vLLM endpoint). An empty key leaves that provider unusable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Reranker (STORY-08.3, SPEC-06 §3, FR-RET-03) ---
# Optional, per-tenant (settings.reranker.enabled, default off). When a tenant sets
# reranker.provider=cohere, COHERE_API_KEY authenticates to the Cohere v2 rerank API
# (fail-closed on providers_allowed; confidential, never logged, C-4). The LLM-based
# reranker (provider=llm) reuses the LLM keys above — no key here. An empty key
# leaves the Cohere reranker fail-closed and the query falls back to fused order.
# COHERE_BASE_URL overrides the endpoint for a self-hosted/proxy rerank deployment.
COHERE_API_KEY=
COHERE_BASE_URL=

# --- Parsing sidecar stub (Python; ADR-0006) ---
PARSER_PORT=8081

# --- App (ragctl serve) host port when run via the `app` compose profile ---
APP_PORT=8080

# --- serve's own listen address (RAGCTL_ADDR; internal/cli/commands.go), separate
# from APP_PORT above. serve exposes /metrics on this same address. Set to :8091 so
# `deploy/obs/prometheus.yml`'s `ragctl-serve` scrape target (host.docker.internal:8091)
# finds it on a fresh `cp .env.example .env`.
RAGCTL_ADDR=:8091

# --- Observability stack host ports (mise run obs; the `obs` compose profile).
# Override any that collide with another local stack (e.g. GRAFANA_PORT=3001).
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100

# --- Control-plane connection used by ragctl / the app against the local stack.
# Must match POSTGRES_* above. Host processes (mprocs) connect via localhost.
CONTROL_PLANE_URL=postgres://rag:rag@localhost:5432/control_plane?sslmode=disable

# --- Tenant provisioning (STORY-02.3, SPEC-01 §6) ---
# Privileged (superuser) connection `ragctl enroll` uses to CREATE ROLE/DATABASE/
# EXTENSION and write the control-plane registry. Falls back to CONTROL_PLANE_URL
# if unset. Never logged. Locally the `rag` user is the cluster superuser.
PROVISION_DB_URL=postgres://rag:rag@localhost:5432/control_plane?sslmode=disable
# Host:port recorded for a newly provisioned tenant's database (how the resolver,
# a host process, reaches it). Locally that is localhost and the mapped port.
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
# sslmode recorded for the tenant DB connection. The local cluster has no TLS, so
# use `disable` locally; production defaults to `require`.
TENANT_DB_SSLMODE=disable

# --- Secrets / envelope encryption (STORY-01.4, SPEC-09 §2) ---
# The platform loads a data-encryption key (DEK) at startup and fails closed if
# it is missing. The DEK is wrapped by a KMS key held OUTSIDE the database.
#
# KMS_PROVIDER selects how the DEK is wrapped: "local" (age, for self-hosted /
# local dev) or "aws" (AWS KMS).
KMS_PROVIDER=local
#
# local(age): AGE_SECRET_KEY is the age X25519 secret key that wraps the DEK.
# Generate one for local dev with:  go run filippo.io/age/cmd/age-keygen
# (never commit a real key; this is a placeholder).
AGE_SECRET_KEY=AGE-SECRET-KEY-1EXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAM0000
#
# Path to the wrapped-DEK blob (age-encrypted 32-byte key). Provisioning
# (`ragctl keys`, later story) produces it; for local dev, wrap a random 32-byte
# key to AGE_SECRET_KEY's recipient and point here.
DEK_WRAPPED_PATH=./local-dek.age
#
# Active DEK generation; new ciphertext is sealed under it. Rotation increments
# it (STORY-10.4).
DEK_KEY_VERSION=1
#
# aws provider only: the AWS KMS key id/ARN that wraps the DEK. Credentials come
# from the ambient AWS environment (env, shared config, or instance role).
# AWS_KMS_KEY_ID=arn:aws:kms:eu-central-1:123456789012:key/xxxxxxxx

# --- Observability (STORY-01.6, SPEC-10) ---
# Structured JSON logging level: debug, info, warn, error. The --log-level flag
# overrides this. Default: info. Set debug to see the per-document ingest steps
# (sink: document received/parsed/chunked/embedding/embedded/committed).
LOG_LEVEL=info
# Log output format: json (default, machine-readable) or text/console
# (human-readable key=value lines for reading the local stack in mprocs).
LOG_FORMAT=json
#
# OpenTelemetry tracing is configured by env and DISABLED by default: with no
# endpoint set, the tracer is a no-op and local dev needs nothing. Point this at
# an OTLP/gRPC collector to enable export.
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# OTEL_EXPORTER_OTLP_INSECURE=true
# Parent-based ratio sampler fraction (0..1); unset/<=0 means always-sample when
# an endpoint is configured.
# OTEL_TRACES_SAMPLER_RATIO=0.1

# --- OIDC login (STORY-03.2, FR-ACC-01, SPEC-09 §3) ---
# OIDC is DISABLED by default: with no issuer set, only email/password login is
# available. Point OIDC_ISSUER at a provider's discovery base URL to enable the
# authorization-code + PKCE flow. OIDC_CLIENT_SECRET is confidential and never
# logged. OIDC_JIT_PROVISIONING=true creates a user on first verified-email login;
# false restricts OIDC login to pre-existing users.
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=rag-admin
# OIDC_CLIENT_SECRET=changeme
# OIDC_REDIRECT_URL=https://app.example.com/auth/oidc/callback
# OIDC_JIT_PROVISIONING=false
