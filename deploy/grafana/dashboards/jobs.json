{
  "uid": "ragctl-jobs",
  "title": "RAG Platform — Jobs",
  "tags": ["ragctl", "spec-10"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Queue depth (SPEC-10 §5 alert: > 500 for 30 min)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 500 } ] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "jobs_queue_depth", "legendFormat": "{{queue}}" }
      ]
    },
    {
      "id": 2,
      "title": "Job failures per kind (SPEC-10 §5 alert: > 5 in 15 min)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "increase(jobs_failed_total[15m])", "legendFormat": "{{kind}}" }
      ]
    },
    {
      "id": 3,
      "title": "Job duration p95 per kind",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(jobs_duration_seconds_bucket[5m])) by (le, kind))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Jobs worked per kind (rate)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(jobs_duration_seconds_count[5m])) by (kind)", "legendFormat": "{{kind}}" }
      ]
    }
  ]
}
