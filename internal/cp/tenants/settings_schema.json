{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-platform/schemas/tenant-settings.json",
  "title": "Tenant settings",
  "description": "The tenants.settings document (SPEC-02 §5). Validated on every write. embedding.dim is immutable after provisioning and is enforced by the settings service, not this schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "dim"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "dim": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 32768}
      }
    },
    "reranker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "top_n": {"type": "integer", "minimum": 1, "maximum": 200}
      }
    },
    "chunking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_tokens", "overlap_tokens"],
      "properties": {
        "target_tokens": {"type": "integer", "minimum": 64, "maximum": 4096},
        "overlap_tokens": {"type": "integer", "minimum": 0, "maximum": 1024}
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["k_vector", "k_text", "final_k", "min_score"],
      "properties": {
        "k_vector": {"type": "integer", "minimum": 1, "maximum": 500},
        "k_text": {"type": "integer", "minimum": 1, "maximum": 500},
        "final_k": {"type": "integer", "minimum": 1, "maximum": 100},
        "min_score": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qps", "max_upload_mb", "max_pages_per_crawl"],
      "properties": {
        "qps": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_upload_mb": {"type": "integer", "minimum": 1, "maximum": 1024},
        "max_pages_per_crawl": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "providers_allowed": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
